{
  "info": {
    "name": "Museo Villa Serena - API",
    "description": "Collezione di richieste per testare le API REST del prototipo (Project Work - Digitalizzazione impresa culturale). L'utente autenticato viene sempre ricavato dal token JWT: nessuna richiesta richiede di specificare un utenteId o dipendenteId nel body o nella query string. L'importo dei pagamenti è sempre ricalcolato lato server e non viene mai inviato dal client.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Registrazione visitatore",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/register?password=Password123",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Giulia\",\n  \"cognome\": \"Verdi\",\n  \"email\": \"giulia.verdi@example.com\"\n}" }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"giulia.verdi@example.com\",\n  \"password\": \"Password123\"\n}" }
          }
        },
        {
          "name": "Cambia password",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/auth/password",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"passwordAttuale\": \"Password123\",\n  \"nuovaPassword\": \"NuovaPassword456\"\n}" }
          }
        }
      ]
    },
    {
      "name": "Catalogo",
      "item": [
        { "name": "Elenco opere", "request": { "method": "GET", "url": "{{baseUrl}}/api/opere" } },
        {
          "name": "Crea opera (Operatore/HR)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/opere",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"titolo\": \"Nuova opera\",\n  \"autore\": \"Mario Rossi\",\n  \"anno\": 2020,\n  \"tecnica\": \"Acrilico su tela\",\n  \"descrizione\": \"Opera di esempio\",\n  \"collezioneId\": 1\n}" }
          }
        },
        {
          "name": "Modifica opera (Operatore/HR)",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/opere/1",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"titolo\": \"Titolo aggiornato\",\n  \"autore\": \"Mario Rossi\",\n  \"anno\": 2020,\n  \"tecnica\": \"Acrilico su tela\"\n}" }
          }
        },
        {
          "name": "Elimina opera (Operatore/HR)",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/opere/1", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] }
        },
        {
          "name": "Carica immagine opera (Operatore/HR)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/upload",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "body": { "mode": "formdata", "formdata": [{ "key": "file", "type": "file", "src": "" }] }
          }
        },
        { "name": "Elenco collezioni", "request": { "method": "GET", "url": "{{baseUrl}}/api/collezioni" } },
        {
          "name": "Crea collezione (Operatore/HR)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/collezioni",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Arte contemporanea\",\n  \"descrizione\": \"Opere di artisti contemporanei\"\n}" }
          }
        }
      ]
    },
    {
      "name": "Eventi",
      "item": [
        { "name": "Elenco eventi", "request": { "method": "GET", "url": "{{baseUrl}}/api/eventi" } },
        {
          "name": "Crea evento (Operatore/HR)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/eventi",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"titolo\": \"Visita serale\",\n  \"descrizione\": \"Apertura straordinaria\",\n  \"tipo\": \"VISITA_GUIDATA\",\n  \"dataInizio\": \"2026-10-01T18:00:00\",\n  \"dataFine\": \"2026-10-01T20:00:00\",\n  \"capienzaMax\": 25,\n  \"prezzo\": 10.00\n}" }
          }
        },
        {
          "name": "Modifica evento (Operatore/HR)",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/eventi/1",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"titolo\": \"Visita serale (nuovo orario)\",\n  \"tipo\": \"VISITA_GUIDATA\",\n  \"dataInizio\": \"2026-10-01T19:00:00\",\n  \"dataFine\": \"2026-10-01T21:00:00\",\n  \"capienzaMax\": 25\n}" }
          }
        },
        {
          "name": "Cambia stato evento (Operatore/HR)",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/eventi/1/stato?stato=DA_RIPROGRAMMARE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Elimina evento (Operatore/HR)",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/eventi/1", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] }
        }
      ]
    },
    {
      "name": "Prenotazioni",
      "item": [
        {
          "name": "Crea prenotazione",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/prenotazioni",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"eventoId\": 1,\n  \"numeroPosti\": 2\n}" }
