        },
        {
          "name": "Le mie prenotazioni",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/prenotazioni/mie", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] }
        },
        {
          "name": "Elenco prenotazioni, filtrabile per evento (Operatore)",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/prenotazioni?eventoId=1", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] }
        },
        {
          "name": "Cerca per codice biglietto (Operatore)",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/prenotazioni/cerca-biglietto/VS-1-1", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] }
        },
        {
          "name": "Check-in biglietto (Operatore)",
          "request": { "method": "PUT", "url": "{{baseUrl}}/api/prenotazioni/check-in/VS-1-1", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] }
        },
        {
          "name": "Accetta nuova data (Visitatore)",
          "request": { "method": "PUT", "url": "{{baseUrl}}/api/prenotazioni/1/accetta-nuova-data", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] }
        },
        {
          "name": "Richiedi rimborso (Visitatore)",
          "request": { "method": "PUT", "url": "{{baseUrl}}/api/prenotazioni/1/richiedi-rimborso", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] }
        },
        {
          "name": "Risolvi d'ufficio (Operatore)",
          "request": { "method": "PUT", "url": "{{baseUrl}}/api/prenotazioni/1/risolvi-ufficio?decisione=RIMBORSA", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] }
        }
      ]
    },
    {
      "name": "Feedback",
      "item": [
        {
          "name": "Invia feedback",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/feedback",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"prenotazioneId\": 1,\n  \"voto\": 5,\n  \"commento\": \"Esperienza molto positiva\"\n}" }
          }
        },
        {
          "name": "Feedback pubblici di un evento",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/feedback/evento/1" }
        },
        {
          "name": "Elenco completo feedback (Operatore/HR)",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/feedback", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] }
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        { "name": "Indicatori sintetici", "request": { "method": "GET", "url": "{{baseUrl}}/api/dashboard", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }] } }
      ]
    },
    {
